# Render Environment Variables Template
# Copy these to your Render dashboard under "Environment"

# Django Settings
SECRET_KEY=your-secret-key-here-render-will-generate
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com

# Database (automatically set by Render if using Blueprint)
DATABASE_URL=postgresql://user:password@host:5432/database

# CORS (if using separate frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# Optional: Custom settings
DJANGO_LOG_LEVEL=INFO
TIME_ZONE=Africa/Nairobi
