# Django POS System - PRODUCTION Environment Variables
# This file contains production-ready configuration for Marid POS

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_ENGINE=postgresql
DATABASE_NAME=marid_pos_db
DATABASE_USER=marid_pos_user
DATABASE_PASSWORD=CHANGE_THIS_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================
# DJANGO SETTINGS
# ============================================
# IMPORTANT: Generate a new SECRET_KEY for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=GENERATE_NEW_SECRET_KEY_HERE

# Production settings
DEBUG=False

# Add your actual domain(s) - separated by commas
ALLOWED_HOSTS=marid.co.ke,www.marid.co.ke,pos.marid.co.ke

# CSRF Trusted Origins (HTTPS)
CSRF_TRUSTED_ORIGINS=https://marid.co.ke,https://www.marid.co.ke,https://pos.marid.co.ke

# ============================================
# EMAIL CONFIGURATION (Mailjet)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Mailjet Production Credentials (info@marid.co.ke)
EMAIL_HOST_USER=46f06713bd67184eb3b783098226f0d9
EMAIL_HOST_PASSWORD=0317e680de9ee8329fe1452ef11f35a6
DEFAULT_FROM_EMAIL=info@marid.co.ke

# Site URL - Update to your actual production domain
SITE_URL=https://pos.marid.co.ke

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# If your cPanel/hosting supports Redis
# REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY SETTINGS (Production)
# ============================================
# Enable these for HTTPS (after SSL is configured)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
# Get DSN from https://sentry.io (recommended for production)
# SENTRY_DSN=your_sentry_dsn_here
