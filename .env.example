# Django POS System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database engine: postgresql or mysql
DATABASE_ENGINE=postgresql

# PostgreSQL Configuration (Recommended)
DATABASE_NAME=pos_db
DATABASE_USER=pos_user
DATABASE_PASSWORD=your_strong_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# MySQL Configuration (Alternative)
# DATABASE_ENGINE=mysql
# DATABASE_NAME=youruser_posdb
# DATABASE_USER=youruser_posuser
# DATABASE_PASSWORD=your_strong_password_here
# DATABASE_HOST=localhost
# DATABASE_PORT=3306

# Read replica for reporting queries (optional)
# DATABASE_REPLICA_URL=postgres://user:pass@replica-host:5432/pos_db

# ============================================
# DJANGO SETTINGS
# ============================================
# Generate new SECRET_KEY using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one

# Field-level encryption key for sensitive data at rest
# Generate using: python -c "from pos.encryption import generate_key; print(generate_key())"
FIELD_ENCRYPTION_KEY=

# Set to False in production
DEBUG=False

# Add your domain(s) separated by commas
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CSRF Trusted Origins (for HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# If your hosting supports Redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# EMAIL CONFIGURATION (Mailjet)
# ============================================
# Email Backend - Use SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Mailjet SMTP Configuration
# Get your API Key and Secret Key from: https://app.mailjet.com/account/api_keys
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Mailjet Credentials
EMAIL_HOST_USER=your_mailjet_api_key
EMAIL_HOST_PASSWORD=your_mailjet_secret_key
DEFAULT_FROM_EMAIL=verified-sender@yourdomain.com

# Site URL for email links (registration verification, password reset)
# PRODUCTION: Update to your actual domain
SITE_URL=https://yourdomain.com

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
# Get DSN from https://sentry.io
SENTRY_DSN=

# ============================================
# SECURITY SETTINGS (Production)
# ============================================
# Set to True if using HTTPS (recommended)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# CPANEL SPECIFIC
# ============================================
# Your cPanel username
CPANEL_USERNAME=yourusername

# ============================================
# CELERY CONFIGURATION
# ============================================
# Uses REDIS_URL by default. Override if using a separate broker.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# CDN / S3 STORAGE (Optional)
# ============================================
# Leave blank to use WhiteNoise (static) + local filesystem (media)
# AWS_STORAGE_BUCKET_NAME=your-s3-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=us-east-1
# CDN_DOMAIN=d1234abcd.cloudfront.net
