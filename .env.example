# Django POS System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database engine: postgresql or mysql
DATABASE_ENGINE=postgresql

# PostgreSQL Configuration (Recommended)
DATABASE_NAME=pos_db
DATABASE_USER=pos_user
DATABASE_PASSWORD=your_strong_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# MySQL Configuration (Alternative)
# DATABASE_ENGINE=mysql
# DATABASE_NAME=youruser_posdb
# DATABASE_USER=youruser_posuser
# DATABASE_PASSWORD=your_strong_password_here
# DATABASE_HOST=localhost
# DATABASE_PORT=3306

# ============================================
# DJANGO SETTINGS
# ============================================
# Generate new SECRET_KEY using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one

# Set to False in production
DEBUG=False

# Add your domain(s) separated by commas
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CSRF Trusted Origins (for HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# If your hosting supports Redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# EMAIL CONFIGURATION (Mailjet)
# ============================================
# Email Backend - Use SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Mailjet SMTP Configuration
# Get your API Key and Secret Key from: https://app.mailjet.com/account/api_keys
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# PRODUCTION Mailjet Credentials (info@marid.co.ke)
EMAIL_HOST_USER=46f06713bd67184eb3b783098226f0d9
EMAIL_HOST_PASSWORD=0317e680de9ee8329fe1452ef11f35a6
DEFAULT_FROM_EMAIL=info@marid.co.ke

# DEVELOPMENT Mailjet Credentials (ropenixkenya@gmail.com) - for testing
# EMAIL_HOST_USER=ac06ca3ddec9510674f1dda74b31f8d4
# EMAIL_HOST_PASSWORD=59e9fcd0f568df53cd8c0a539b685405
# DEFAULT_FROM_EMAIL=ropenixkenya@gmail.com

# Site URL for email links (registration verification, password reset)
# PRODUCTION: Update to your actual domain
SITE_URL=https://yourdomain.com

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
# Get DSN from https://sentry.io
SENTRY_DSN=

# ============================================
# SECURITY SETTINGS (Production)
# ============================================
# Set to True if using HTTPS (recommended)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# CPANEL SPECIFIC
# ============================================
# Your cPanel username
CPANEL_USERNAME=yourusername
