# Django POS System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_NAME=youruser_posdb
DATABASE_USER=youruser_posuser
DATABASE_PASSWORD=your_strong_password_here
DATABASE_HOST=localhost
DATABASE_PORT=3306

# ============================================
# DJANGO SETTINGS
# ============================================
# Generate new SECRET_KEY using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one

# Set to False in production
DEBUG=False

# Add your domain(s) separated by commas
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# If your hosting supports Redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
# Get DSN from https://sentry.io
SENTRY_DSN=

# ============================================
# SECURITY SETTINGS
# ============================================
# Set to True if using HTTPS (recommended)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================
# CPANEL SPECIFIC
# ============================================
# Your cPanel username
CPANEL_USERNAME=yourusername
