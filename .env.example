# Email Configuration for Ropenix Kenya POS
# Copy this file to .env and fill in your app password

# Email Backend (use console for testing, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ropenixkenya@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password-here
DEFAULT_FROM_EMAIL=ropenixkenya@gmail.com

# Example app password format: abcd efgh ijkl mnop (remove spaces when entering)
# Get your app password from: https://myaccount.google.com/apppasswords
