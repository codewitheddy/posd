# Alternative Dockerfile for Python 3.11 with Django 5.1
# Rename this to "Dockerfile" if you prefer Python 3.11

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (using Python 3.11 compatible requirements)
COPY requirements-py311.txt requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# Make start script executable
RUN chmod +x start.sh

# Collect static files
RUN python manage.py collectstatic --no-input

# Create media directory
RUN mkdir -p /app/media

EXPOSE $PORT

CMD ["./start.sh"]
